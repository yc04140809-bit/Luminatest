    "event": {
      "_readme": "enabled:trueにしたイベントは、天候・季節よりさらに優先される(誕生日/クリスマス等の特別な日だけ差し替えたい場合用)。",
      "birthday":  { "enabled": false, "image": "img/koufuku/room/bg-birthday.webp" },
