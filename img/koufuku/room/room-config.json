      "midnight": { "enabled": true, "image": "img/koufuku/room/room_master.webp" }
    },
    "weather": {
      "_readme": "enabled:trueにした天候は、時間帯背景より優先して使われる(将来、天気APIや天気システムと連動させる拡張ポイント)。",
      "rain":  { "enabled": false, "image": "img/koufuku/room/bg-rain.webp" },
