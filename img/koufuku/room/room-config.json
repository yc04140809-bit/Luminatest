  "entranceAnimations": {
    "_readme": "起動時、ここに列挙した『気づかれる前のケイオスちゃん』候補から、enabled:trueかつweightの重みに応じて1件だけランダムに選ばれる(weightの合計は100でなくてもよく、enabledな項目内での相対比率として扱われる)。選ばれた後は必ず定位置まで歩いてきて挨拶する、という一連の流れ自体は共通。durationMsは定位置まで歩いてくる演出の目安秒数(実際はモーション速度設定で多少前後する)。startOffsetは『最初に見える時の位置』を部屋の中心からのズレ(px)・縮小率・回転角(度)で指定する。",
    "items": [
      { "id": "wave",        "label": "手を振る",           "pose": "wave",   "enabled": true, "weight": 40, "durationMs": 1100, "startOffset": { "x": 0,   "y": 0,   "scale": 1,    "rotation": 0 } },
      { "id": "read",        "label": "読書",               "pose": "read",   "enabled": true, "weight": 10, "durationMs": 1100, "startOffset": { "x": -30, "y": -14, "scale": 0.82, "rotation": 0 } },
      { "id": "window",      "label": "窓を見る",           "pose": "window", "enabled": true, "weight": 15, "durationMs": 1100, "startOffset": { "x": 36,  "y": -10, "scale": 0.84, "rotation": 0 } },
      { "id": "sofa",        "label": "ソファで休む",       "pose": "sofa",   "enabled": true, "weight": 20, "durationMs": 1100, "startOffset": { "x": -46, "y": 6,   "scale": 0.86, "rotation": 0 } },
      { "id": "stretch",     "label": "ストレッチ",         "pose": "sit",    "enabled": true, "weight": 15, "durationMs": 1100, "startOffset": { "x": 44,  "y": 10,  "scale": 0.86, "rotation": 0 } },
      { "id": "bow",         "label": "お辞儀",             "pose": "bow",    "enabled": true, "weight": 0,  "durationMs": 1100, "startOffset": { "x": 0,   "y": 0,   "scale": 1,    "rotation": 0 } },
      { "id": "water_plant", "label": "植物に水をあげる",   "pose": "sit",    "enabled": true, "weight": 0,  "durationMs": 1100, "startOffset": { "x": -30, "y": -14, "scale": 0.82, "rotation": 0 } },
      { "id": "coffee",      "label": "コーヒーを飲む",     "pose": "sit",    "enabled": true, "weight": 0,  "durationMs": 1100, "startOffset": { "x": 36,  "y": -10, "scale": 0.84, "rotation": 0 } }
    ]
  },

  "furniture": {
    "_readme": "部屋の育成用の装飾リスト。既定では空(装飾なし)。追加するには{id, image, x, y, scale, rotation, opacity, zIndex, enabled}を持つオブジェクトをitemsへ足すだけで、コード変更なしに#kaosuRoomFurniture内へ描画される。x/yは部屋シーン基準の位置(%指定、0-100)。",
