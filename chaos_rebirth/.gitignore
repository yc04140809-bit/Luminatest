# Godot 4+ specific ignores
.godot/
.import/
export.cfg
export_credentials.cfg

# Export presets are committed (no secrets: encrypt_pck=false, no local paths).
# Export *output* (built binaries/html/wasm) is not committed.
build/

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
