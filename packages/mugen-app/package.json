{
  "name": "@mugen/app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:debug": "tsc -p tsconfig.json --noEmit && vite build --mode debug",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "playwright test",
    "check:release": "node scripts/check-release-has-no-debug.mjs",
    "check:portraits": "node scripts/check-portrait-masters.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run build:debug && cap sync android && cd android && ./gradlew assembleDebug",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/noto-serif-jp": "^5.3.0",
    "@mugen/assets": "*",
    "@mugen/core": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^6.0.3",
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2"
  }
}
